# ==============================================================================
# RESQNET AI — Master Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or configure `backend/.env` and `frontend/.env`.
# DO NOT commit real secrets, passwords, or production credentials to git.

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Allowed Frontend Origins (comma-separated for CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security & Session Secret Key (Must be set to a secure random string in production)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Persistent SQLite Database Location
DATABASE_URL=sqlite:///./resqnet.db

# Offline HumAID DistilBERT Model Directory
MODEL_DIR=./data/nlp/models/resqnet_distilbert_full

# Optional External API Keys (Leave blank for offline / local-only operation)
HF_TOKEN=
MAPS_API_KEY=

# Official India Meteorological & Hydrological Integration (IMD & NWDP/CWC)
# Register at https://api.imd.gov.in/ to generate official IMD API key and JWT token
IMD_API_KEY=
IMD_AUTH_TOKEN=
# Set to false to disable simulated fallback feeds when government credentials are unconfigured
ENABLE_DEMO_SIMULATED_FEEDS=true

# ------------------------------------------------------------------------------
# Frontend Configuration (React 19 + Vite 8)
# ------------------------------------------------------------------------------
# Production Backend on Render:
VITE_API_BASE_URL=https://resqnet-backend-pi59.onrender.com
# Local Development (uncomment for local uvicorn instance):
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Map Tile Configuration
# Default Satellite Provider: Esri World Imagery (No API key required)
# Default Streets Provider: OpenStreetMap (No API key required)
# Default Dark Map Provider: CartoDB Dark Matter (No API key required)
#
# Optional custom XYZ/WMTS tile server overrides:
# VITE_MAP_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_MAP_STREETS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
