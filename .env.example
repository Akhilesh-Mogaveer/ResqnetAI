# ==============================================================================
# RESQNET AI — Master Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` or configure `backend/.env` and `frontend/.env`.
# DO NOT commit real secrets, passwords, or production credentials to git.

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Allowed Frontend Origins (comma-separated for CORS)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Security & Session Secret Key (Must be set to a secure random string in production)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Persistent SQLite Database Location
DATABASE_URL=sqlite:///./resqnet.db

# Offline HumAID DistilBERT Model Directory
MODEL_DIR=./data/nlp/models/resqnet_distilbert

# Optional External API Keys (Leave blank for offline / local-only operation)
HF_TOKEN=
MAPS_API_KEY=

# ------------------------------------------------------------------------------
# Frontend Configuration (React 19 + Vite 8)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000

# Optional Custom Tile Server / Mapbox Token (Defaults to OpenStreetMap)
# VITE_MAP_TILES_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
# VITE_MAPBOX_TOKEN=
