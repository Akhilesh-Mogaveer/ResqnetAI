# RESQNET AI Backend Environment Variables
ENV=development
DEBUG=True
HOST=127.0.0.1
PORT=8000

# Allowed Frontend Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# SQLite Persistent Database Location
DATABASE_URL=sqlite:///./resqnet.db

# Path to trained HumAID DistilBERT model directory
MODEL_DIR=../data/nlp/models/resqnet_distilbert_full

# Security & Secret Key (Generate a random string for production)
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# Optional External API Credentials (Leave empty for offline operation)
HF_TOKEN=
MAPS_API_KEY=

# Official India Meteorological & Hydrological Integration (IMD & NWDP/CWC)
IMD_API_KEY=
IMD_AUTH_TOKEN=
ENABLE_DEMO_SIMULATED_FEEDS=true
