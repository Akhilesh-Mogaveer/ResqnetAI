# RESQNET AI — Frontend Environment Configuration
# Production Backend on Render:
VITE_API_BASE_URL=https://resqnet-backend-pi59.onrender.com

# Local Development Backend (uncomment if running local uvicorn instance):
# VITE_API_BASE_URL=http://127.0.0.1:8000

# Map Tile Configuration
# Default Satellite Provider: Esri World Imagery (No API key required)
# Default Streets Provider: OpenStreetMap (No API key required)
# Default Dark Map Provider: CartoDB Dark Matter (No API key required)
#
# Optional custom XYZ/WMTS tile server overrides:
# VITE_MAP_SATELLITE_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
# VITE_MAP_STREETS_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
