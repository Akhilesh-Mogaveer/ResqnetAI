# ==============================================================================
# RESQNET AI — Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables & Secret Credentials
# ------------------------------------------------------------------------------
# Ignore all local environment files in any directory
.env
.env.*
*.env
*.env.*
**/.env
**/.env.*

# Keep example configuration templates tracked in repository
!.env.example
!*.env.example
!**/.env.example

# Private cryptographic keys & credentials
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
*.id_rsa
*.pub
secrets/
credentials.json
client_secrets.json

# ------------------------------------------------------------------------------
# 2. Database & Data Stores
# ------------------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.rdb
*.dump

# ------------------------------------------------------------------------------
# 3. Python & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Virtual Environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Packaging & Distribution
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ------------------------------------------------------------------------------
# 4. Machine Learning & Model Checkpoints
# ------------------------------------------------------------------------------
# Model weights & state dictionaries (too large for Git)
*.pt
*.pth
*.bin
*.safetensors
*.onnx
*.h5
*.tflite
*.ckpt
checkpoint-*/
checkpoints/

# ML Pipeline directories (preserve structure with .gitkeep)
data/nlp/models/*
!data/nlp/models/.gitkeep
data/nlp/logs/*
!data/nlp/logs/.gitkeep
data/nlp/outputs/predictions/*
!data/nlp/outputs/predictions/.gitkeep
data/nlp/datasets/processed/*
!data/nlp/datasets/processed/.gitkeep
data/nlp/datasets/splits/*
!data/nlp/datasets/splits/.gitkeep

# Large compressed archives
*.zip
*.tar
*.tar.gz
*.tgz
*.gz
*.rar
*.7z

# ------------------------------------------------------------------------------
# 5. Frontend & Node.js Artifacts
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
frontend/dist/
frontend/dist-ssr/
*.local
.turbo/
.parcel-cache/

# ------------------------------------------------------------------------------
# 6. Logs & Temporary Files
# ------------------------------------------------------------------------------
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.tmp
*.bak
*~

# ------------------------------------------------------------------------------
# 7. Operating System & Editor Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
__MACOSX/
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
[Dd]esktop.ini

# Editors & IDEs
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
